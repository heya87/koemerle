# Local DB (used by compose.yaml and DATABASE_URL)
DB_USER=root
DB_PASSWORD=
DB_NAME=koemerle

# Drizzle / SvelteKit
# Local dev: postgres://${DB_USER}:${DB_PASSWORD}@localhost:5999/${DB_NAME}
# Production: use the DATABASE_URL from Railway
DATABASE_URL="postgres://root:your-password@localhost:5999/koemerle"

ORIGIN=""

# Fooby recipe cache TTL in minutes (default: 1440 = 24h)
# FOOBY_CACHE_TTL_MINUTES=1440

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Biogmüsabo + Bring! are per-family now (Settings → Familie), stored encrypted in the
# database. These env vars only remain as a fallback for the original family (id 1) —
# every other family must configure its own credentials in Settings.
BIOABO_EMAIL=""
BIOABO_PASSWORD=""
# Cron schedule for auto-sync, runs once for every family that has Biogmüsabo configured
# (default: daily at 5am)
# BASKET_SYNC_CRON="0 5 * * *"

BRING_EMAIL=""
BRING_PASSWORD=""
BRING_LIST_ID=""
BRING_LIST_NAME=""
BRING_LIST_ID_2=""
BRING_LIST_NAME_2=""

# Claude AI meal suggestions — shared API key across all families, but each family must
# be individually enabled by an admin in /admin (off by default).
ANTHROPIC_API_KEY=""

# Local dev seed only (npm run db:clean / db:seed) — creates a dev family + these 2 users.
# FAMILY_NAME="Dev-Familie"
# USER1_EMAIL=""
# USER1_PASSWORD=""
# USER2_EMAIL=""
# USER2_PASSWORD=""
